<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net7.0</TargetFrameworks>
    <LangVersion>11</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>NU1701</NoWarn>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>RhinoMCP</AssemblyName>
    <RootNamespace>RhinoMCP</RootNamespace>
    <Version>0.4.6</Version>
    <Title>Rhino MCP</Title>
    <Description>Automatic Rhino bridge with a local browser dashboard and viewport connection strip.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net7.0'" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Dashboard/index.html" LogicalName="RhinoMCP.Dashboard.index.html" />
  </ItemGroup>
</Project>
